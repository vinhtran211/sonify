# Sonify Environment Configuration Template
# Copy to .env for local overrides or set in your cloud provider dashboard (e.g. Render).
# NEVER commit real secrets or cookies to version control!

# ---------------------------------------------------------------------------
# Server & Storage
# ---------------------------------------------------------------------------
SONIFY_HOST=127.0.0.1
SONIFY_PORT=8080
SONIFY_DB=data/sonify.db

# ---------------------------------------------------------------------------
# Security, Sessions & Access Control
# ---------------------------------------------------------------------------
# 32+ byte random hex string used to HMAC-SHA256 sign `sonify_sid` cookies across restarts.
# Generate locally with: python3 -c "import secrets; print(secrets.token_hex(32))"
SONIFY_SESSION_SECRET=

# Set to 1 on public multi-user cloud deployments to require isolated sessions on API calls.
SONIFY_REQUIRE_SESSION=0

# Optional single-owner API bearer token (Authorization: Bearer <token> or X-Sonify-Token).
# Leave empty for open/session-isolated access.
SONIFY_API_TOKEN=

# Pin the public HTTPS origin used for iOS .mobileconfig / OTA manifest links (prevents Host spoofing).
SONIFY_PUBLIC_ORIGIN=

# Comma-separated list of trusted Host / X-Forwarded-Host hostnames (RENDER_EXTERNAL_HOSTNAME is auto-included).
SONIFY_ALLOWED_HOSTS=

# Optional comma-separated list of allowed cross-origin browser origins for CSRF checks.
SONIFY_ALLOWED_ORIGINS=

# Per-IP general request rate limit (requests/minute). Set to 0 to disable during local load tests.
SONIFY_RATE_LIMIT_RPM=180

# Production debug controls: set SONIFY_ALLOW_DEBUG=0 in cloud; optionally set SONIFY_DEBUG_TOKEN
# to authorize `?debug=1` via the `X-Sonify-Debug-Token` header.
SONIFY_ALLOW_DEBUG=0
SONIFY_DEBUG_TOKEN=

# ---------------------------------------------------------------------------
# Streaming & Playback Flags
# ---------------------------------------------------------------------------
# Keep 0 (default) so users NEVER receive 30-second previews; set 1 only to opt in.
SONIFY_ALLOW_PREVIEWS=0

# Set to 1 to force offline synthesized demo catalog mode.
SONIFY_OFFLINE=0

# ---------------------------------------------------------------------------
# Optional iOS Distribution Links
# ---------------------------------------------------------------------------
SONIFY_TESTFLIGHT_URL=
SONIFY_IOS_IPA_URL=
SONIFY_IOS_BUNDLE_ID=com.sonify.music
SONIFY_GITHUB_REPO=

# ---------------------------------------------------------------------------
# Optional Cloud YouTube / yt-dlp Credentials (leave blank unless needed)
# ---------------------------------------------------------------------------
YTDLP_COOKIES_B64=
YTDLP_COOKIES_PATH=
YTDLP_PROXY=
